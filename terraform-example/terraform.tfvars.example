region    = "eu-central-1"
unique_id = "demo"

# ECR image built from secret-rotator/ (see docs/manual-setup.md)
ecr_image_uri = "YOUR_ACCOUNT_ID.dkr.ecr.YOUR_REGION.amazonaws.com/jfrog-secret-rotator-lambda:latest"

jfrog_host = "your-company.jfrog.io"

# JFrog IAM role tagging (default true). Set false if the mapping already exists.
assign_jfrog_iam_role = true
jfrog_admin_username  = "your-jfrog-username"
# jfrog_admin_token   = "..."  # required when assign_jfrog_iam_role is true

# Token TTL must exceed the rotation schedule window
# Example: rate(4 hours) → secret_ttl of 21600 (6 hours) or more
secret_ttl                   = "21600"
rotation_schedule_expression = "rate(4 hours)"
rotation_duration            = "4h"

# Trigger the first rotation right after apply instead of waiting for the schedule
trigger_initial_rotation = true

create_ecs              = false
alb_allowed_cidr_blocks = ["0.0.0.0/0"]  # Restrict to YOUR_IP/32 in production

tags = {
  Environment = "Demo"
  Group       = "CTO"
  ManagedBy   = "terraform"
}
